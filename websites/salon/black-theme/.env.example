# Where the server reaches the Aj Smart Biz API. Must be ABSOLUTE — a server-side
# fetch has no page to resolve a relative path against — so in production point
# this at the API's internal address even if browsers reach it same-origin.
# Read at runtime: change it and restart, no rebuild needed.
API_URL=http://localhost:4000/api/v1

# Origin the browser should load company logos and favicons from.
#
# Leave EMPTY (the default). Images then stay relative — /uploads/... — so the
# browser asks this site for them and Next proxies them to the API. That is the
# only thing that works over a dev tunnel, from a phone on the LAN, or in
# production, because an absolute http://localhost:4000 URL points at whatever
# machine the *visitor* is on.
#
# Set it only when uploads are served from their own public origin, e.g. a CDN.
NEXT_PUBLIC_FILES_URL=

# Local development only. The domain sent to the company-details API is taken
# from here instead of the Host header. Leave unset in production.
#
# Filled in, unlike the white theme's, because a port does not identify a
# tenant: the API's resolver strips it before matching, so localhost:4400 and
# localhost:4500 are the same host and cannot name two companies. The label in
# front is what separates them, and every browser resolves *.localhost to the
# loopback with no hosts-file entry.
#
# This is the tenant `npm run db:seed:salon` writes in the backend.
TENANT_DOMAIN=salon.localhost
