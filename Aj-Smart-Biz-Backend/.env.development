NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# ---------- Database ----------
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aj_smartbiz_dev
DB_USER=root
DB_PASSWORD=root@123
DB_LOGGING=true
# alter | force | none  -> how sequelize.sync() runs on boot
DB_SYNC_MODE=alter

# ---------- JWT ----------
JWT_SECRET=aj-smart-biz-dev-access-secret-change-me
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=aj-smart-biz-dev-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Auto-created Super Admin (checked on every boot) ----------
SUPER_ADMIN_NAME=Aj Super Admin
SUPER_ADMIN_EMAIL=superadmin@ajsmartbiz.com
SUPER_ADMIN_PHONE=9999999999
SUPER_ADMIN_PASSWORD=Admin@123

# ---------- Misc ----------
CORS_ORIGINS=http://localhost:4200,http://localhost:4300
BCRYPT_SALT_ROUNDS=10
DEFAULT_COMPANY_ADMIN_PASSWORD=Company@123

# ---------- Uploads (branch logo / favicon) ----------
UPLOAD_DIR=uploads
UPLOAD_PUBLIC_PATH=/uploads
UPLOAD_MAX_SIZE_MB=2

# ---------- Customer sign-in ----------
# The code every customer gets while NO SMS GATEWAY IS CONNECTED.
#
# There is no SMS provider wired in yet, so a real random code would be one
# nobody could read - sign-in would be impossible rather than secure. The API
# returns this one in the response, labelled as a development code, and the
# website prints it with that label rather than pretending a message was sent.
#
# NOT SAFE FOR PRODUCTION: anyone who knows a customer's mobile number can sign
# in as them. Connecting a gateway is the gate before this goes live - see
# hasSmsGateway() in src/services/customer.service.js, which is the one place
# that decides.
CUSTOMER_OTP_DEV_CODE=123456
