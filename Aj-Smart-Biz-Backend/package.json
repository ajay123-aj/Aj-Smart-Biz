{
  "name": "aj-smart-biz-backend",
  "version": "1.0.0",
  "description": "Aj Smart Biz - multi-tenant SaaS backend (Express + Sequelize)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "cross-env NODE_ENV=production node src/server.js",
    "start:dev": "cross-env NODE_ENV=development node src/server.js",
    "dev": "cross-env NODE_ENV=development nodemon src/server.js",
    "db:sync": "cross-env NODE_ENV=development node src/scripts/sync.js",
    "db:seed": "cross-env NODE_ENV=development node src/scripts/seed.js"
  },
  "keywords": [
    "saas",
    "multi-tenant",
    "express",
    "sequelize"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "mysql2": "^3.11.0",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "sqlite3": "^5.1.7"
  }
}
