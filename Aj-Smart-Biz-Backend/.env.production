NODE_ENV=production
PORT=8080
API_PREFIX=/api/v1

# ---------- Database ----------
DB_DIALECT=mysql
DB_HOST=CHANGE_ME
DB_PORT=3306
DB_NAME=aj_smart_biz
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_LOGGING=false
# In production prefer "none" and run migrations explicitly; "alter" is allowed for first roll-out.
DB_SYNC_MODE=none

# ---------- JWT ----------
JWT_SECRET=CHANGE_ME_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=CHANGE_ME_STRONG_RANDOM_REFRESH_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Auto-created Super Admin (checked on every boot) ----------
SUPER_ADMIN_NAME=Aj Super Admin
SUPER_ADMIN_EMAIL=superadmin@ajsmartbiz.com
SUPER_ADMIN_PHONE=9999999999
SUPER_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---------- Misc ----------
CORS_ORIGINS=https://superadmin.ajsmartbiz.com,https://admin.ajsmartbiz.com
BCRYPT_SALT_ROUNDS=12
DEFAULT_COMPANY_ADMIN_PASSWORD=CHANGE_ME

# ---------- Uploads (branch logo / favicon) ----------
# Point UPLOAD_DIR at a persistent volume - it must survive redeploys.
UPLOAD_DIR=uploads
UPLOAD_PUBLIC_PATH=/uploads
UPLOAD_MAX_SIZE_MB=2
