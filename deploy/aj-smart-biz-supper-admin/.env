# ------------------------------------------------------------------ #
# Aj Smart Biz - Super Admin console. Server configuration.
#
# This file is the one place the running console is configured. It lives on the
# deploy server, NOT in the image: the image is identical for every
# environment, and this is what makes it dev, staging or production.
#
#     sudo mkdir -p /opt/aj-smart-biz
#     sudo cp deploy/aj-smart-biz-supper-admin/.env /opt/aj-smart-biz/supper-admin.env
#     sudo chmod 600 /opt/aj-smart-biz/supper-admin.env
#
# The deploy workflow reads it from that path and refuses to deploy without it.
# Point somewhere else with the SUPPER_ADMIN_ENV_FILE repository variable.
#
# ---------------------------- format rules ---------------------------- #
#
# These are not stylistic. This file is handed to `docker run --env-file`,
# which is not a shell and does not parse like one:
#
#   * NO QUOTES. --env-file does not strip them. API_ORIGIN="http://host:4000"
#     sets the value to a string that literally begins with a quote mark, and
#     nginx then fails to start on a config it cannot parse.
#   * NO SPACES around `=`, and no trailing comment after a value. The rest of
#     the line is taken literally, comment and all.
#   * NO ${...} EXPANSION. --env-file expands nothing.
#   * A line that is blank, or starts with `#`, is ignored. Those are the only
#     two kinds of line that are not KEY=VALUE.
# ------------------------------------------------------------------ #


# ----------------------------- the console ----------------------------- #

# Where the console reaches the API.
#
# The production Angular build calls the API at `/api/v1` on its OWN origin,
# and the nginx inside this image proxies that to the value below. So this is
# not a convenience -- unset or wrong, the console loads and every request in
# it fails.
#
# `aj-smart-biz-backend` is a container name, resolved on the private Docker
# network the deploy job joins. It is not a hostname on your LAN and it does
# not need a DNS record.
#
# NO TRAILING SLASH and no path: the request URI is appended to this value, so
# `http://host:4000` gives the API /api/v1/companies, and a trailing slash
# gives it //api/v1/companies.
API_ORIGIN=http://aj-smart-biz-backend:4000

# The container's clock, which is what nginx stamps its access and error logs
# with. UTC unless you set it, which makes correlating a log line with a
# support call needlessly hard.
TZ=Asia/Kolkata


# ------------------------------ the deploy ------------------------------ #
#
# Read by the deploy workflow rather than by the console. They are here so that
# one file on the server describes the whole deployment, instead of half of it
# living in the GitHub settings page.

# The port the console is published on, on the server. Inside the container
# nginx always listens on 80; this is only the outside half of the mapping, so
# changing it cannot break the app, only move it.
#
# Check the port is free before changing it -- 4000 is the API and 3306 is
# MySQL on this server. The deploy fails early and says so if it is taken.
HOST_PORT=4200
