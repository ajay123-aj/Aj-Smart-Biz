# ------------------------------------------------------------------ #
# Aj Smart Biz Technology - the product website. Server configuration.
#
# This file lives on the deploy server, NOT in the image:
#
#     sudo mkdir -p /opt/aj-smart-biz
#     sudo cp deploy/aj-smart-biz-technology/.env /opt/aj-smart-biz/technology.env
#     sudo chmod 600 /opt/aj-smart-biz/technology.env
#
# The deploy workflow reads it from that path and refuses to deploy without it.
# Point somewhere else with the TECHNOLOGY_ENV_FILE repository variable.
#
# ---------------------- why this file is nearly empty ---------------------- #
#
# Every other service on the platform is configured here: the API gets its
# database and its secrets, the consoles get an API origin, the tenant themes
# get an API URL. **This site needs none of it**, and the emptiness is the
# point rather than an omission.
#
# It calls no API. Its plans, capabilities and business types are compiled in
# from `src/content/`, and the demo form composes a WhatsApp or mail link in
# the visitor's own browser rather than posting anywhere. So the image is
# genuinely identical in every environment and there is nothing to get wrong.
#
# The file still exists, and the deploy still requires it, because "every
# service is configured the same way" is worth more than saving one file. When
# this site does start calling the API - see the project README - API_URL goes
# here and nothing else about the deployment changes.
#
# ---------------------------- format rules ---------------------------- #
#
# These are not stylistic. This file is handed to `docker run --env-file`,
# which is not a shell and does not parse like one:
#
#   * NO QUOTES. --env-file does not strip them.
#   * NO SPACES around `=`, and no trailing comment after a value. The rest of
#     the line is taken literally, comment and all.
#   * NO ${...} EXPANSION. --env-file expands nothing.
#   * A line that is blank, or starts with `#`, is ignored. Those are the only
#     two kinds of line that are not KEY=VALUE.
# ------------------------------------------------------------------ #


# ------------------------------- the site ------------------------------- #

# Where the site reaches the API.
#
# **Required.** Every word on this site -- the headlines, the price list, the
# capability list, the trades and the FAQ -- is read from
# `GET /website/bootstrap` at request time, and the demo form posts to
# `POST /website/enquiries`. There is no content compiled into the image any
# more and no fallback copy, so an unset or wrong value is a site that renders
# an error instead of a home page.
#
# `aj-smart-biz-backend` is a container name, resolved on the private Docker
# network the deploy job joins. It is not a hostname on your LAN and needs no
# DNS record.
#
# INCLUDE `/api/v1` and no trailing slash -- the path is appended directly, so
# this value plus `/website/bootstrap` has to be the whole URL.
#
# Not a `NEXT_PUBLIC_` name, deliberately: Next inlines those into the browser
# bundle at build time, which would bake one environment's API address into an
# image meant to run in all of them. Every call using this runs on the server.
API_URL=http://aj-smart-biz-backend:4000/api/v1

# The container's clock, which the logs are stamped with. UTC unless you set
# it, which makes correlating a log line with a support call needlessly hard.
TZ=Asia/Kolkata


# ------------------------------ the deploy ------------------------------ #
#
# Read by the deploy workflow rather than by the site.

# The port the site is published on, on the server. Inside the container the
# server always listens on 4700; this is only the outside half of the mapping,
# so changing it cannot break the app, only move it.
#
# Check the port is free before changing it - 4000 is the API, 4200 and 4300
# are the consoles, and 4400/4500/4600 are the tenant sites on this server.
# The deploy fails early and says so if it is taken.
HOST_PORT=4700
# Hosts allowed to submit a Server Action to this app.
#
# Next compares a Server Action's `Origin` against the `Host` it was served on
# and refuses the action when they differ. That is a CSRF defence and the right
# default -- but it fails on any hop that rewrites Host, which is what a dev
# tunnel does. The browser sends the public origin, the container sees its own,
# and sign-in, the cart, bookings and the enquiry form all fail with
# "a server-side exception has occurred".
#
# LEAVE THIS EMPTY IN PRODUCTION. Behind nginx the Host *is* the public domain
# -- `proxy_set_header Host $host` -- so Origin already matches and the check
# passes. Setting it here would only weaken a defence that is working.
#
# No scheme. Comma separated. Wildcards match subdomains only. Examples:
#
#   ALLOWED_ORIGINS=**.devtunnels.ms,localhost:4600
#   ALLOWED_ORIGINS=my-tunnel.devtunnels.ms,localhost:4600
#
# INCLUDE THE PORT, and list every origin you actually browse from. Next matches
# on the origin's host *with* its port, so `localhost` does not match
# `localhost:4600`, and a wildcard cannot cover it. Both directions of the
# mismatch happen: browse the tunnel and the origin is the tunnel while the host
# is localhost; browse localhost while a tunnel forwards and it is the reverse.
ALLOWED_ORIGINS=
