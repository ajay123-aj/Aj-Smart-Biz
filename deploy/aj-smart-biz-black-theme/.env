# ------------------------------------------------------------------ #
# Aj Smart Biz - salon tenant theme (black). Server configuration.
#
# This file is the one place the running site is configured. It lives on the
# deploy server, NOT in the image: the image is identical for every
# environment, and this is what makes it dev, staging or production.
#
#     sudo mkdir -p /opt/aj-smart-biz
#     sudo cp deploy/aj-smart-biz-black-theme/.env /opt/aj-smart-biz/black-theme.env
#     sudo chmod 600 /opt/aj-smart-biz/black-theme.env
#
# The deploy workflow reads it from that path and refuses to deploy without it.
# Point somewhere else with the BLACK_THEME_ENV_FILE repository variable.
#
# ---------------------------- format rules ---------------------------- #
#
# These are not stylistic. This file is handed to `docker run --env-file`,
# which is not a shell and does not parse like one:
#
#   * NO QUOTES. --env-file does not strip them. API_URL="http://host:4000"
#     sets the value to a string that literally begins with a quote mark, and
#     every request the site makes then fails.
#   * NO SPACES around `=`, and no trailing comment after a value. The rest of
#     the line is taken literally, comment and all.
#   * NO ${...} EXPANSION. --env-file expands nothing.
#   * A line that is blank, or starts with `#`, is ignored. Those are the only
#     two kinds of line that are not KEY=VALUE.
# ------------------------------------------------------------------ #


# -------------------------------- the API -------------------------------- #

# Where this site reaches the Aj Smart Biz API, from the server.
#
# Must be ABSOLUTE: a server-side fetch has no page to resolve a relative path
# against. `aj-smart-biz-backend` is a container name, resolved on the private
# Docker network the deploy joins - it is not a hostname on your LAN and needs
# no DNS record.
#
# Include the /api/v1 prefix and NO trailing slash. The deploy refuses a value
# ending in one, because the path is appended and every call would go to a
# doubled // path.
#
# Unset or wrong, the site still renders - and every visitor sees the
# service-unavailable page instead of a company. It is read per request, so
# correcting it needs a restart, not a rebuild.
API_URL=http://aj-smart-biz-backend:4000/api/v1

# The container's clock, which the logs are stamped with. UTC unless you set
# it, which makes correlating a log line with a support call needlessly hard.
TZ=Asia/Kolkata


# ------------------------------ the tenant ------------------------------ #

# LEAVE THIS UNSET IN PRODUCTION.
#
# One deployment serves many companies: the site reads the host each request
# arrived on and asks the API which company owns it. That is the product.
#
# TENANT_DOMAIN is a local-development convenience, for a dev server on
# `localhost`, where the host names no tenant at all. It is a FALLBACK and not
# a pin - a request arriving on a real host always resolves by that host - but
# on a server there is no reason for it to be set, and setting it only creates
# a value that will look load-bearing to the next person reading this file.
#
# A host that matches no company gets the company-not-found page, which is the
# correct answer and the signal that a domain still needs mapping in the
# admin console under Domain manager.
# TENANT_DOMAIN=


# Origin the browser should load company logos and favicons from.
#
# Leave EMPTY. Images then stay relative - /uploads/... - so the browser asks
# this site for them and Next proxies them to the API, which is the only thing
# that works on every host a visitor might arrive on.
#
# Set it only when uploads are served from their own public origin, e.g. a CDN.
# Note it is compiled into the browser bundle at BUILD time, so setting it here
# does nothing: it is a build argument on the workflow, not a runtime value.
NEXT_PUBLIC_FILES_URL=


# ------------------------------ the deploy ------------------------------ #
#
# Read by the deploy workflow rather than by the site. They are here so that
# one file on the server describes the whole deployment, instead of half of it
# living in the GitHub settings page.

# The port the site is published on, on the server. Inside the container the
# server always listens on 4500; this is only the outside half of the mapping,
# so changing it cannot break the app, only move it.
#
# Check the port is free before changing it - 4000 is the API, 4200 and 4300
# are the consoles, and 4400/4600/4700 are the other sites on this server. The
# deploy fails early and says so if it is taken.
HOST_PORT=4500
