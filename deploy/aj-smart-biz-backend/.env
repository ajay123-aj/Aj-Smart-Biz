# ------------------------------------------------------------------ #
# Aj Smart Biz - the API. Server configuration.
#
# This file is the one place the running API is configured. It lives on the
# deploy server, NOT in the image: the image is identical for every
# environment, and this is what makes it dev, staging or production.
#
#     sudo mkdir -p /opt/aj-smart-biz
#     sudo cp deploy/aj-smart-biz-backend/.env /opt/aj-smart-biz/backend.env
#     sudo chmod 600 /opt/aj-smart-biz/backend.env
#
# `chmod 600` matters more here than on any other service on the platform:
# this file holds the database password and the token signing secrets.
#
# The deploy workflow reads it from that path and refuses to deploy without it.
# Point somewhere else with the BACKEND_ENV_FILE repository variable.
#
# ---------------------------- format rules ---------------------------- #
#
# These are not stylistic. This file is handed to `docker run --env-file`,
# which is not a shell and does not parse like one:
#
#   * NO QUOTES. --env-file does not strip them. DB_PASSWORD="hunter2" sets
#     the password to a string that literally begins with a quote mark, and
#     the API then fails to connect with an authentication error that says
#     nothing about quoting.
#   * NO SPACES around `=`, and no trailing comment after a value. The rest of
#     the line is taken literally, comment and all.
#   * NO ${...} EXPANSION. --env-file expands nothing.
#   * A line that is blank, or starts with `#`, is ignored. Those are the only
#     two kinds of line that are not KEY=VALUE.
# ------------------------------------------------------------------ #


# ------------------------------- runtime ------------------------------- #

NODE_ENV=production

# The port the API listens on INSIDE the container. The deploy publishes it
# on HOST_PORT below; changing this one means changing the Dockerfile's
# EXPOSE and healthcheck too, so leave it alone unless you mean it.
PORT=4000

API_PREFIX=/api/v1

# The container's clock, which the logs are stamped with. UTC unless you set
# it, which makes correlating a log line with a support call needlessly hard.
TZ=Asia/Kolkata


# ------------------------------ the database ------------------------------ #
#
# `aj-smart-biz-mysql` is a container name, resolved on the private Docker
# network the deploy joins. It is not a hostname on your LAN and needs no DNS
# record. Point DB_HOST at a managed database's real hostname instead if you
# are not running MySQL in Docker.

DB_DIALECT=mysql
DB_HOST=aj-smart-biz-mysql
DB_PORT=3306
DB_NAME=aj_smart_biz
DB_USER=aj_smart_biz

# CHANGE THIS. The deploy checks the variable is set; it cannot check that it
# is not still the word below.
DB_PASSWORD=change-me

# SQL in the logs. Useful once, unreadable in production, and it prints the
# values bound into every statement.
DB_LOGGING=false

# How the schema is reconciled at boot.
#
#   alter  add missing columns and indexes in place - what development uses
#   none   touch nothing
#
# `alter` on a production database means the API rewrites tables on the way
# up, against whatever the last deploy happened to ship. Leave it `none` here
# and run migrations deliberately.
DB_SYNC_MODE=none


# -------------------------------- tokens -------------------------------- #
#
# CHANGE BOTH, and make them different from each other. A shared secret means
# a refresh token is accepted as an access token.
#
#     openssl rand -base64 48
#
# Changing either signs out everyone holding a token signed with the old one,
# which is the point if one has leaked.

JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=7d


# ------------------------------ first sign-in ------------------------------ #
#
# The super admin seeded on an empty database. Used once, on the very first
# boot; after that the row exists and these are ignored.
#
# CHANGE THE PASSWORD, and sign in and change it again afterwards - it stays
# in this file in clear text.

SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@ajsmartbiz.in
SUPER_ADMIN_PHONE=9000000000
SUPER_ADMIN_PASSWORD=change-me

# The password a newly created company's first admin gets. They are told to
# change it; this is what it starts as.
DEFAULT_COMPANY_ADMIN_PASSWORD=Company@123

# Higher is slower to verify and slower to brute force. 10 is the default and
# is fine; 12 is defensible. Do not lower it.
BCRYPT_SALT_ROUNDS=10


# -------------------------------- browsers -------------------------------- #
#
# Which origins may call this API from a browser. Comma-separated, no spaces,
# scheme included, NO trailing slash - these are compared literally against
# the Origin header.
#
# The two consoles need to be here. The tenant websites do NOT: they call the
# API from their own server, not from the visitor's browser, so no Origin
# header is involved.
CORS_ORIGINS=https://admin.ajsmartbiz.in,https://console.ajsmartbiz.in


# -------------------------------- uploads -------------------------------- #
#
# Where company logos, product photographs and gallery images are written.
#
# **This path is a Docker volume.** The deploy mounts `aj-smart-biz-uploads`
# over /app/uploads, which is what stops every redeploy wiping customer files -
# a container's own filesystem does not survive being replaced. Changing
# UPLOAD_DIR to a path outside that mount silently reintroduces exactly that
# problem, and nobody notices until the first redeploy.
#
#     docker volume inspect aj-smart-biz-uploads     where it really lives
#     docker run --rm -v aj-smart-biz-uploads:/u -v /backup:/b alpine \
#       tar czf /b/uploads.tgz -C /u .               how to back it up
UPLOAD_DIR=uploads
UPLOAD_PUBLIC_PATH=/uploads
UPLOAD_MAX_SIZE_MB=2


# ------------------------------ the deploy ------------------------------ #
#
# Read by the deploy workflow rather than by the API. They are here so that one
# file on the server describes the whole deployment, instead of half of it
# living in the GitHub settings page.

# The port the API is published on, on the server. Inside the container it
# always listens on PORT above; this is only the outside half of the mapping,
# so changing it cannot break the app, only move it.
#
# Check the port is free before changing it - 3306 is MySQL and 4200/4300 are
# the consoles on this server. The deploy fails early and says so if it is
# taken.
HOST_PORT=4000
